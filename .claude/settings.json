{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit(docs/**)",
      "Write(docs/**)",
      "Edit(specs/**)",
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(evals/**)",
      "Edit(features/**)",
      "Edit(prompts/**)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make eval-quick*)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(aws *)",
      "Edit(config/**)",
      "Edit(infra/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./data/raw/**)",
      "Bash(git push *)",
      "Bash(curl *)",
      "Bash(rm -rf *)",
      "Bash(aws * --profile prod*)",
      "Bash(aws appconfig *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/pii_guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/log_change.py"
          }
        ]
      }
    ]
  }
}
