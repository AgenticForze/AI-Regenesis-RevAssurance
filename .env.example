# Copy to .env (which is git-ignored) and fill in. Never commit real values.
PARTNER_TOKEN=
RA_DEMO_PASSWORD=
# External identity provider (leave empty to use the built-in one)
RA_OIDC_ISSUER=
RA_OIDC_AUDIENCE=revenue-assurance
RA_OIDC_ROLES_CLAIM=roles
# Amazon Bedrock (leave RA_LLM_MODE=offline to run without AWS)
RA_LLM_MODE=offline
RA_BEDROCK_TRIAGE_MODEL=
RA_BEDROCK_REASON_MODEL=
# Plug-in secrets
RA_JIRA_TOKEN=
RA_SNOW_PASSWORD=
RA_SLACK_WEBHOOK_URL=
RA_WEBHOOK_SECRET=
